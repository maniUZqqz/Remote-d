#!/usr/bin/env python3
"""pc - the owner's Windows computers as if they were servers (PC Remote, 2026-11-10). Independent of NMarketing.

    pc                          the computers and whether their tunnel is up
    pc invite [HOURS]           a new setup file (PC-Remote-Setup.bat, valid HOURS, default 72) for any number of computers
    pc revoke ID                cancel an invitation at once (its key and its file in out/); registered computers keep working
    pc NAME                     an interactive PowerShell on that computer (Administrator)
    pc NAME run 'COMMAND'       one PowerShell command
    pc NAME put LOCAL REMOTE    copy a file to it     (REMOTE like C:/Users/QQz/Desktop/x.txt)
    pc NAME get REMOTE LOCAL    copy a file from it
    pc remove NAME              forget a computer (its tunnel key stops working)

Each computer runs PC-Remote-Setup.bat once: it keeps an encrypted reverse tunnel to this server
(user pcremote, only its own port on 127.0.0.1) and its SSH server listens only on its own 127.0.0.1.
"""
import base64
import json
import os
import secrets
import socket
import subprocess
import sys
import time

BASE = "/opt/pc-remote"
NODES = os.path.join(BASE, "nodes")
INVITES = os.path.join(BASE, "invites.json")
INVITE_DIR = os.path.join(BASE, "invites")
OUT = os.path.join(BASE, "out")
TEMPLATE = os.path.join(BASE, "windows", "PC-Remote-Setup.template.bat")
ZIP_SHA256 = "0ca131f3a78f404dc819a6336606caec0db1663a692ccc3af1e90232706ada54"
ENROLL_KEYS = "/var/lib/pcenroll/.ssh/authorized_keys"
TUNNEL_KEYS = "/var/lib/pcremote/.ssh/authorized_keys"
KNOWN = "/root/.ssh/pc_known_hosts"
ADMIN = "/root/.ssh/pc_admin"
HOST_KEY = "/etc/ssh/ssh_host_ed25519_key.pub"
PUBLIC_HOST = "87.107.160.17"


def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def write(path, text, mode=0o600, owner=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8", newline="") as fh:
        fh.write(text)
    os.chmod(tmp, mode)
    if owner:
        import pwd

        pw = pwd.getpwnam(owner)
        os.chown(tmp, pw.pw_uid, pw.pw_gid)
    os.replace(tmp, path)


def nodes():
    if not os.path.isdir(NODES):
        return []
    return [read_json(os.path.join(NODES, f), {}) for f in sorted(os.listdir(NODES)) if f.endswith(".json")]


def up(port):
    try:
        with socket.create_connection(("127.0.0.1", int(port)), timeout=3) as s:
            s.settimeout(3)
            return s.recv(40).startswith(b"SSH-")
    except OSError:
        return False


def node(name):
    n = read_json(os.path.join(NODES, name + ".json"), None)
    if not n:
        sys.exit("unknown computer '%s' - see: pc" % name)
    return n


def ssh_opts(n):
    return ["-p", str(n["port"]), "-i", ADMIN, "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", "-o", "StrictHostKeyChecking=yes",
            "-o", "UserKnownHostsFile=" + KNOWN, "-o", "ServerAliveInterval=30"]


def prune_invites():
    inv = read_json(INVITES, {})
    now = time.time()
    alive = {k: v for k, v in inv.items() if float(v.get("expires", 0)) > now}
    try:
        with open(ENROLL_KEYS, encoding="utf-8") as fh:
            lines = [ln for ln in fh.read().splitlines() if ln.strip()]
    except OSError:
        lines = []
    keep = [ln for ln in lines if any(ln.rstrip().endswith(" pc-invite:%s" % k) for k in alive)]
    if keep != lines:
        write(ENROLL_KEYS, "\n".join(keep) + ("\n" if keep else ""), owner="pcenroll")
    if alive != inv:
        write(INVITES, json.dumps(alive, indent=1))
    for f in os.listdir(INVITE_DIR) if os.path.isdir(INVITE_DIR) else []:
        if f.split(".")[0] not in alive:
            os.remove(os.path.join(INVITE_DIR, f))
    for f in os.listdir(OUT) if os.path.isdir(OUT) else []:
        if f.startswith("PC-Remote-Setup-") and f[len("PC-Remote-Setup-"):].split(".")[0] not in alive:
            os.remove(os.path.join(OUT, f))
    return alive


def cmd_list():
    alive = prune_invites()
    rows = nodes()
    if not rows:
        print("no computer yet - make a setup file with:  pc invite")
    for n in rows:
        print("%-22s port %-6s %-12s user %-12s %s  (Windows: %s)" % (
            n.get("name"), n.get("port"), "tunnel UP" if up(n.get("port", 0)) else "tunnel down", n.get("user"),
            n.get("enrolled_at", ""), n.get("windows", "")[:40]))
    for k, v in alive.items():
        print("invite %s valid until %s" % (k, time.strftime("%Y-%m-%d %H:%M", time.localtime(float(v["expires"])))))


def cmd_invite(hours):
    prune_invites()
    iid = secrets.token_hex(6)
    os.makedirs(INVITE_DIR, exist_ok=True)
    key = os.path.join(INVITE_DIR, iid)
    subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "pc-invite-" + iid, "-f", key], check=True)
    with open(key + ".pub", encoding="utf-8") as fh:
        algo, body = fh.read().split()[:2]
    try:
        with open(ENROLL_KEYS, encoding="utf-8") as fh:
            lines = [ln for ln in fh.read().splitlines() if ln.strip()]
    except OSError:
        lines = []
    # the invitation key can only run pc-enroll (as root through a narrow sudo rule); nothing else, no forwarding, no pty
    lines.append('restrict,command="sudo -n /opt/pc-remote/bin/pc-enroll %s \\"${SSH_ORIGINAL_COMMAND:-none}\\"" %s %s pc-invite:%s'
                 % (iid, algo, body, iid))
    write(ENROLL_KEYS, "\n".join(lines) + "\n", owner="pcenroll")
    inv = read_json(INVITES, {})
    expires = time.time() + hours * 3600
    inv[iid] = {"expires": expires, "created": time.time()}
    write(INVITES, json.dumps(inv, indent=1))
    with open(HOST_KEY, encoding="utf-8") as fh:
        hk = fh.read().split()
    with open(key, "rb") as fh:
        enroll_b64 = base64.b64encode(fh.read()).decode()
    with open(TEMPLATE, encoding="utf-8") as fh:
        t = fh.read()
    for k, v in {"@@HOST@@": PUBLIC_HOST, "@@KNOWN_HOSTS@@": "%s %s %s" % (PUBLIC_HOST, hk[0], hk[1]),
                 "@@ENROLL_KEY_B64@@": enroll_b64, "@@ZIP_SHA256@@": ZIP_SHA256,
                 "@@EXPIRES@@": time.strftime("%Y-%m-%d %H:%M", time.localtime(expires))}.items():
        t = t.replace(k, v)
    out = os.path.join(OUT, "PC-Remote-Setup-%s.bat" % iid)
    write(out, t.replace("\r\n", "\n").replace("\n", "\r\n"), mode=0o600)
    print(out)
    print("valid until %s (any number of computers)" % time.strftime("%Y-%m-%d %H:%M", time.localtime(expires)))


def cmd_revoke(iid):
    """An invitation that leaked (or is simply no longer needed): expire it now; prune_invites() then deletes its key from
    pcenroll's authorized_keys, its key files and its setup file. Computers already registered are not affected (they use
    their own tunnel key)."""
    inv = read_json(INVITES, {})
    if iid not in inv:
        sys.exit("unknown invitation '%s' - see: pc" % iid)
    inv[iid]["expires"] = 0
    write(INVITES, json.dumps(inv, indent=1))
    prune_invites()
    print("revoked invitation %s: its key and its setup file no longer work (registered computers are not affected)" % iid)


def cmd_remove(name):
    n = node(name)
    marker = " pc:%s" % n["name"]
    with open(TUNNEL_KEYS, encoding="utf-8") as fh:
        lines = [ln for ln in fh.read().splitlines() if ln.strip() and not ln.rstrip().endswith(marker)]
    write(TUNNEL_KEYS, "\n".join(lines) + ("\n" if lines else ""), owner="pcremote")
    hk = "[127.0.0.1]:%d " % n["port"]
    try:
        with open(KNOWN, encoding="utf-8") as fh:
            known = [ln for ln in fh.read().splitlines() if ln.strip() and not ln.startswith(hk)]
        write(KNOWN, "\n".join(known) + ("\n" if known else ""))
    except OSError:
        pass
    os.remove(os.path.join(NODES, n["name"] + ".json"))
    subprocess.run(["pkill", "-u", "pcremote", "-f", "sshd: pcremote"], capture_output=True)   # drop its live tunnel
    print("removed %s" % n["name"])


def main(argv):
    if not argv:
        return cmd_list()
    if argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if argv[0] == "invite":
        return cmd_invite(float(argv[1]) if len(argv) > 1 else 72)
    if argv[0] == "remove" and len(argv) == 2:
        return cmd_remove(argv[1])
    if argv[0] == "revoke" and len(argv) == 2:
        return cmd_revoke(argv[1])
    n = node(argv[0])
    if not up(n["port"]):
        sys.exit("the tunnel of %s is down (the computer is off, or its internet)" % n["name"])
    rest = argv[1:]
    if not rest:
        os.execvp("ssh", ["ssh"] + ssh_opts(n) + ["-l", n["user"], "-t", "127.0.0.1"])
    if rest[0] == "run" and len(rest) > 1:
        os.execvp("ssh", ["ssh"] + ssh_opts(n) + ["-l", n["user"], "127.0.0.1", " ".join(rest[1:])])
    if rest[0] in ("put", "get") and len(rest) == 3:
        opts = [o if o != "-p" else "-P" for o in ssh_opts(n)]
        remote = "%s@127.0.0.1:" % n["user"]
        src, dst = (rest[1], remote + rest[2]) if rest[0] == "put" else (remote + rest[1], rest[2])
        os.execvp("scp", ["scp"] + opts + [src, dst])
    print(__doc__)
    sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
